rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for lessons
    match /korasty_lessons/{lessonId} {
      allow read, write: if true;
    }

    // Rules for books
    match /korasty_books/{bookId} {
      allow read, write: if true;
    }

    // Rules for comments
    match /korasty_comments/{commentId} {
      allow read, write: if true;
    }
  }
}
